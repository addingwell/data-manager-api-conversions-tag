setup: |-
  const Promise = require('Promise');
  const JSON = require('JSON');

  // Mutable per-scenario event data; default to a minimal purchase event.
  let mockEventData = { event_name: 'purchase' };

  // getAllEventData returns whatever the scenario set on mockEventData.
  mock('getAllEventData', () => mockEventData);

  // Deterministic stubs for environment APIs used by the tag.
  mock('getTimestampMillis', () => 1700000000000);  mock('getGoogleAuth', () => { return { type: 'google_auth' }; });

  // Returns a minimal valid `data` object (one Google Ads destination,
  // required SELECT defaults). Scenarios override fields as needed.
  function makeBaseData() {
    return {
      googleAdsDestinations: [{
        operatingCustomerId: '3426547582',
        customerId: '6436831588',
        conversionEventId: '6328279871'
      }],
      eventSource: 'WEB',
      validateOnly: false,
      encoding: 'HEX',
      requestAdUserDataConsent: 'CONSENT_STATUS_UNSPECIFIED',
      requestAdPersonalizationConsent: 'CONSENT_STATUS_UNSPECIFIED',
      customerType: 'not_set',
      customerValueBucket: 'not_set',
      gtmOnSuccess: () => {},
      gtmOnFailure: () => {}
    };
  }


