  userPropertiesMapped.customerType = makeString(eventData.new_customer) == 'true' ? 'NEW' : 'RETURNING';
} else if(eventData.customer_type) {
  userPropertiesMapped.customerType = eventData.customer_type.toUpperCase();
}

if (data.customerValueBucket != "not_set") {
  userPropertiesMapped.customerValueBucket = data.customerValueBucket;
}

if (data.additionalUserProperties || eventData['x-ga-mp2-user_properties']) {
  userPropertiesMapped.additionalUserProperties = [];
}

if (eventData['x-ga-mp2-user_properties']) {
  const gaUserProps = eventData['x-ga-mp2-user_properties'];
  Object.keys(gaUserProps).forEach(function (propertyName) {
    const raw = gaUserProps[propertyName];
    const value = (raw !== null && typeof raw === 'object' && raw.value !== undefined) ? raw.value : raw;

    userPropertiesMapped.additionalUserProperties.push({
      propertyName: propertyName,
      value: makeString(value)
    });
  });
}

if (data.additionalUserProperties) {
  data.additionalUserProperties.forEach(function (additionalUserProperty) {
    userPropertiesMapped.additionalUserProperties.push({
      propertyName: additionalUserProperty.propertyName,
      value: additionalUserProperty.value
    });
  });
}

event.userProperties = userPropertiesMapped;

if(JSON.stringify(event.userProperties) == '{}') {
  event.userProperties = undefined;
}

/* ============================================================
   ADDITIONAL EVENT PARAMETERS BLOCK
============================================================ */

let additionalEventParameters = [];

let parametersToWatch = [
  'tax',
  'coupon',
  'shipping',
  'creative_name',
  'creative_slot',
  'promotion_id',
  'promotion_name'
];

parametersToWatch.forEach((parameter) => {
  if(eventData[parameter]) {
    additionalEventParameters.push({
      parameterName: parameter,
      value: makeString(eventData[parameter])
    });
  }
});

if(data.additionalEventParameters) {
  data.additionalEventParameters.forEach((parameter) => {
    additionalEventParameters.push(parameter);
  });
}

if(additionalEventParameters.length > 0) {
  event.additionalEventParameters = additionalEventParameters;
}

/* ============================================================
   CART DATA BLOCK
============================================================ */

let itemsData = getItemsData();

if(itemsData && itemsData.items.length > 0) {
  event.cartData = itemsData;
}

if (eventData.aw_merchant_id || eventData.aw_feed_label || eventData.aw_feed_language || data.merchantId || data.merchantFeedLabel || data.merchantFeedLanguageCode) {
  if (!event.cartData) event.cartData = {};
  event.cartData.merchantId = data.merchantId || eventData.aw_merchant_id;
  event.cartData.merchantFeedLabel = data.merchantFeedLabel || eventData.aw_feed_label;
  event.cartData.merchantFeedLanguageCode = data.merchantFeedLanguageCode || eventData.aw_feed_language;
}

function getItemsData() {

  let itemsData = {};

  itemsData.items = [];
  itemsData.transactionDiscount = 0;

  if(eventData.items && eventData.items.length > 0) {
    eventData.items.forEach(item => {

      if(item.discount) {
        itemsData.transactionDiscount += item.discount;
      }

      let additionalItemParameters = [];
      let allAddtionalParameters = [
        "item_name",
        "affiliation",
        "coupon",
        "discount",
        "index",
        "item_brand",
        "item_category",
        "item_category2",
        "item_category3",
        "item_category4",
        "item_category5",
        "item_list_id",
        "item_list_name"
      ];

      allAddtionalParameters.forEach(additionalParameter => {
        if(item[additionalParameter]) {
          additionalItemParameters.push({
            parameterName: additionalParameter,
            value: makeString(item[getItemField(additionalParameter)])
          });
        }
      });

      itemsData.items.push({
        merchantProductId: item[getItemField('merchant_product_id')] || item[getItemField('item_id')],
        itemId: item[getItemField('item_id')],
        quantity: makeString(item[getItemField('quantity')]),
        unitPrice: item[getItemField('price')],
        additionalItemParameters: additionalItemParameters.length > 0 ? additionalItemParameters : undefined
      });

    });
  }

  return itemsData;
}

/* ============================================================
   CUSTOM VARIABLES BLOCK
============================================================ */

if(data.customVariables) {
  event.customVariables = [];
  data.customVariables.forEach(customVariable => {
    event.customVariables.push({
      variable: customVariable.variable,
      value: customVariable.value
    });
  });
}


/* ============================================================
   COMMON DATA OVERRIDES
============================================================ */

if(data.commonDataList) {
  data.commonDataList.forEach(d => {
    if(d.name == "conversionValue") {
      event[d.name] = makeNumber(d.value);
    } else {
      event[d.name] = d.value;
    }
  });
}

/* ============================================================
   EVENT LOCATION BLOCK
============================================================ */

if(data.eventLocationList) {
  event.eventLocation = {};
  data.eventLocationList.forEach(d => {
    event.eventLocation[d.name] = d.value;
  });
}

/* ============================================================
   FINAL REQUEST
============================================================ */

requestParams.events = [];
requestParams.events.push(event);
requestParams.validateOnly = data.validateOnly === undefined || data.validateOnly === true || data.validateOnly === "true";

const auth = getGoogleAuth({
  scopes: [
    'https://www.googleapis.com/auth/datamanager'
  ]
});

sendHttpRequest(
  apiEndpoint,
  {
    headers: { 'Content-Type': 'application/json' },
    method: 'POST',
    authorization: auth
  },
  JSON.stringify(requestParams)
).then((result) => {
  if (result.statusCode >= 200 && result.statusCode < 300) {
    data.gtmOnSuccess();
  } else {
    data.gtmOnFailure();
  }
});

/* ============================================================
   UTILITIES
============================================================ */

function getItemField(defaultField) {
  let result = defaultField;

  const map = {
    merchant_product_id: 'merchant_product_id',
    item_id: 'item_id',
    item_name: 'item_name',
    price: 'price',
    quantity: 'quantity'
  };

  if (data.itemDataList) {
    data.itemDataList.forEach(d => {
      if (map[defaultField] === d.name) {
        result = d.field;
      }
    });
  }

  return result;
}

function enc(data) {
  data = data || '';
  return encodeUriComponent(data);
}

function isAlreadyHashed(input){
  return input && (input.toString().match('^[A-Fa-f0-9]{64}$') != null);
}

function hashData(input){
  if(input == null || isAlreadyHashed(input)){
    return input;
  }
  return sha256Sync(input.toString().trim().toLowerCase(), {outputEncoding: data.encoding.toLowerCase()});
}

function formatTimestampToISO(milliseconds) {
    // Constants
    var MS_PER_SECOND = 1000;
    var MS_PER_MINUTE = 60 * MS_PER_SECOND;
    var MS_PER_HOUR = 60 * MS_PER_MINUTE;
    var MS_PER_DAY = 24 * MS_PER_HOUR;

    // Calculate date components
    var daysSinceEpoch = Math.floor(milliseconds / MS_PER_DAY);
    var remainingMs = milliseconds % MS_PER_DAY;

    // Base epoch (1970-01-01)
    var year = 1970;
    var month = 0; // Months are 0-based
    var day = 1;

    // Determine the year, month, and day
    while (daysSinceEpoch >= daysInYear(year)) {
        daysSinceEpoch = daysSinceEpoch - daysInYear(year);
        year++;
    }

    while (daysSinceEpoch >= daysInMonth(year, month)) {
        daysSinceEpoch = daysSinceEpoch - daysInMonth(year, month);
        month++;
    }

    day += daysSinceEpoch;

    // Time components
    var hours = Math.floor(remainingMs / MS_PER_HOUR);
    remainingMs = remainingMs % MS_PER_HOUR;

    var minutes = Math.floor(remainingMs / MS_PER_MINUTE);
    remainingMs = remainingMs % MS_PER_MINUTE;

    var seconds = Math.floor(remainingMs / MS_PER_SECOND);

    // Timezone offset (assuming UTC for simplicity, adjust if needed)
    var timezoneOffsetMinutes = 0; // Replace with actual offset in minutes if known
    var sign = timezoneOffsetMinutes >= 0 ? "+" : "-";
    var offsetHours = Math.floor(Math.abs(timezoneOffsetMinutes) / 60);
    var offsetMinutes = Math.abs(timezoneOffsetMinutes) % 60;

    // Pad values
    return (
        year +
        "-" +
        padZero(month + 1) +
        "-" +
        padZero(day) +
        "T" +
        padZero(hours) +
        ":" +
        padZero(minutes) +
        ":" +
        padZero(seconds) +
        sign +
        padZero(offsetHours) +
        ":" +
        padZero(offsetMinutes)
    );
}

function daysInYear(year) {
    return isLeapYear(year) ? 366 : 365;
}
function isLeapYear(year) {
    return (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0;
}
function daysInMonth(year, month) {
    var days = [31,28,31,30,31,30,31,31,30,31,30,31];
    if (month === 1 && isLeapYear(year)) return 29;
    return days[month];
}
function padZero(num) {
    return num < 10 ? "0" + num : num;
}


